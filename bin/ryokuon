#!/usr/bin/env bash
# transcript.txt is one utterance per line (startMs|speaker|text), so grep
# and awk already do everything this needs — no reason to build and sign a
# separate Swift binary for it (Q8).
set -euo pipefail

# Match the GUI's chosen storage root; RYOKUON_ROOT remains the explicit
# override for automation and isolated tests.
configured_root=""
if [[ -z "${RYOKUON_ROOT:-}" ]] && command -v defaults >/dev/null 2>&1; then
    configured_root="$(defaults read dev.ryokuon.app dev.ryokuon.storageRootPath 2>/dev/null || true)"
fi
ROOT="${RYOKUON_ROOT:-${configured_root:-$HOME/Documents/ryokuon}}"

usage() {
    cat <<EOF
usage: ryokuon list
       ryokuon show <session-path>
       ryokuon search <session-path> <keyword>
       ryokuon range <session-path> <startMs> <endMs>
EOF
    exit 1
}

require_transcript() {
    local session="$1"
    case "$session" in
        ""|/*|..|../*|*/../*|*/..) echo "invalid session path" >&2; exit 1 ;;
    esac
    local root path directory
    root="$(cd -P "$ROOT" 2>/dev/null && pwd)" || { echo "storage root unavailable" >&2; exit 1; }
    directory="$(cd -P "$ROOT/$session" 2>/dev/null && pwd)" || { echo "session unavailable" >&2; exit 1; }
    [[ "$directory" == "$root/"* ]] || { echo "session is outside the storage root" >&2; exit 1; }
    path="$directory/transcript.txt"
    if [[ ! -f "$path" || -L "$path" ]]; then
        echo "no transcript.txt for session '$session' (looked in $path)" >&2
        exit 1
    fi
    echo "$path"
}

cmd="${1:-}"
case "$cmd" in
    list)
        if [[ -d "$ROOT" ]]; then
            while IFS= read -r -d '' metadata; do
                path="${metadata#"$ROOT"/}"
                dirname "$path"
            done < <(find "$ROOT" -type f -name session.json -print0 2>/dev/null) | sort -r
        fi
        ;;
    show)
        [[ $# -ge 2 ]] || usage
        cat "$(require_transcript "$2")"
        ;;
    search)
        [[ $# -ge 3 ]] || usage
        grep -n -F -B2 -A2 -- "$3" "$(require_transcript "$2")" || true
        ;;
    range)
        [[ $# -ge 4 ]] || usage
        [[ "$3" =~ ^[0-9]+$ && "$4" =~ ^[0-9]+$ && ${#3} -le 12 && ${#4} -le 12 ]] || { echo "range must use nonnegative integer milliseconds" >&2; exit 1; }
        awk -v start="$3" -v end="$4" 'BEGIN { exit !(end >= start) }' || { echo "range end precedes start" >&2; exit 1; }
        awk -F'|' -v start="$3" -v end="$4" \
            '{ ts = $1 + 0; if (ts >= start && ts <= end) print }' \
            "$(require_transcript "$2")"
        ;;
    *)
        usage
        ;;
esac
